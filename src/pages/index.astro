---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Open Lokanetra Products"
	description="Page for public access to selected web-apps, datasets, and github repo from Lokanetra Information Observatory."
	footer={false}
>
	<main class="home">
		<h1 class="display-title"><a href="/reports/">Open Lokanetra Products</a></h1>
	</main>
</Layout>

<style>
	.home {
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 0 1.5rem;
		text-align: center;
	}

	.home .display-title {
		margin: 0;
		font-size: clamp(3rem, 9vw, 8rem);
	}

	.home a {
		color: inherit;
		text-decoration: none;
	}
</style>
